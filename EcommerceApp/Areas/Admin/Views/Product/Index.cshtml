@model IEnumerable<Product>
@if (TempData["Success"] != null)
{
    <p>@TempData["Success"]</p>
}
<div class="container mt-4">
    <h2>Product List</h2>
</div>
<a asp-area="Admin"
   asp-controller="Product"
   asp-action="Create">
    Create Product
</a>
@if(Model.Any())
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Category</th>
                <th>Created Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model){
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Stock</td>
                    <td>@product.Category?.Name</td>
                    <td>@product.CreatedDate.ToString("dd-MM-yyyy")</td>
                    <td><a asp-action="Edit" asp-route-id="@product.Id">Edit</a>|<a asp-action="Delete" asp-route-id="@product.Id">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No Product Found</p>
}