@model Product

<div style="max-width:900px;margin:30px auto;padding:20px;border:1px solid #ddd;border-radius:10px;display:flex;flex-wrap:wrap;gap:30px;">

    <div style="flex:1;min-width:300px;">
        <img src="/images/products/@Model.ImageUrl"
             alt="@Model.Name"
             style="width:100%;height:400px;object-fit:cover;border-radius:8px;" />
    </div>

    <div style="flex:1;min-width:300px;">

        <h1 style="margin-top:0;">@Model.Name</h1>

        <h2 style="color:green;">
            @Model.Price.ToString("C")
        </h2>

        <p>
            <strong>Category:</strong>
            @Model.Category?.Name
        </p>

        <p>
            <strong>Description:</strong><br />
            @Model.Description
        </p>

        <p>
            <strong>Stock:</strong>
            @Model.Stock
        </p>

        <div style="margin-top:30px;">
            <a href="#"
               style="display:inline-block;padding:10px 20px;background:#007bff;color:#fff;text-decoration:none;border-radius:5px;margin-right:10px;">
                Add to Cart
            </a>

            <a asp-action="Index"
               style="display:inline-block;padding:10px 20px;background:#6c757d;color:#fff;text-decoration:none;border-radius:5px;">
                Back to Products
            </a>
        </div>

    </div>

</div>