@model IEnumerable<Product>

<h1>All Products</h1>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">

    @foreach (var product in Model)
    {
        <div style="border:1px solid #ddd;padding:15px;border-radius:8px;text-align:center;">

            <img src="/images/products/@product.ImageUrl"
                 alt="@product.Name"
                 style="width:100%;height:220px;object-fit:cover;border-radius:5px;" />

            <ul style="list-style:none;padding:0;margin:15px 0 0;">
                <li style="font-size:20px;font-weight:bold;">
                    @product.Name
                </li>

                <li style="margin-top:8px;color:green;font-size:18px;">
                    $@product.Price
                </li>

                <li style="margin-top:8px;">
                    @product.Category?.Name
                </li>

                <li style="margin-top:15px;">
                    <a asp-action="Details" asp-route-id="@product.Id" style="margin-right:15px;">View Details</a>
                    <form asp-action="AddToCart"
                          asp-route-productId="@product.Id"
                          method="post"
                          style="display:inline;">

                        @Html.AntiForgeryToken()

                        <button type="submit">
                            Add to Cart
                        </button>

                    </form>
                </li>
            </ul>

        </div>
    }

</div>